# LearnSphere AI — Required Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit real secrets to git.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Required in production. Application will FAIL to start without this.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=learnsphere

# ── Gemini AI ──────────────────────────────────────────────────────────────────
# Required. Application will FAIL to start without this in production.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── Flask Security ─────────────────────────────────────────────────────────────
# Required in production. Use a long random string (32+ chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

# ── Deployment ─────────────────────────────────────────────────────────────────
# Set to 'production' on Render. Set to 'development' for local SQLite fallback.
ENV=production

# Render assigns PORT automatically — do NOT hardcode it.
# PORT=10000

# If frontend and backend are on SEPARATE Render services, set these:
# FRONTEND_URL=https://your-frontend.onrender.com
# If they share one service (recommended), leave FRONTEND_URL blank.
